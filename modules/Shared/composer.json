{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "figure-admin/shared",
    "description": "Canonical shared form and table core for Figure Admin packages.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Shared\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Shared\\Providers\\SharedServiceProvider"
            ]
        }
    }
}
