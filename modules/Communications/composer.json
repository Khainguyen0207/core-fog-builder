{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "figure-admin/communications",
    "description": "Communications administration package for the Figure admin application.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "figure-admin/booking": "dev-main",
        "figure-admin/host": "^1.0",
        "figure-admin/shared": "dev-main",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Communications\\": "src/"
        },
        "classmap": [
            "src/Domain/",
            "database/seeders/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Communications\\Providers\\CommunicationsServiceProvider"
            ]
        }
    }
}
