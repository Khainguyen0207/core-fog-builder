{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "figure-admin/booking",
    "description": "Booking administration package for the Figure admin application.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "figure-admin/host": "^1.0",
        "figure-admin/shared": "dev-main",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Booking\\": "src/"
        },
        "classmap": [
            "src/Domain/",
            "database/factories/",
            "database/seeders/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Booking\\Providers\\BookingServiceProvider"
            ]
        }
    }
}
