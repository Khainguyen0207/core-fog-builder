{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "figure-admin/workforce",
    "description": "Workforce administration package for the Figure admin application.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "figure-admin/catalog": "dev-main",
        "figure-admin/host": "^1.0",
        "figure-admin/shared": "dev-main",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Workforce\\": "src/"
        },
        "classmap": [
            "src/Domain/"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Workforce\\Providers\\WorkforceServiceProvider"
            ]
        }
    }
}
